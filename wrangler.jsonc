{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "breach",
	"compatibility_date": "2026-05-18",
	"compatibility_flags": ["nodejs_compat", "nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"env": {
		"production": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "breach-production",
					"database_id": "cc131580-6596-4c34-adfc-d6f97a0a2337",
					"migrations_dir": "./drizzle"
				}
			],
			"kv_namespaces": [
				{
					"binding": "KV",
					"id": "dfdb5605bfdf42a8a929ef34611b1e6d"
				}
			],
			"vars": {
				"TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
			},
			"r2_buckets": [
				{
					"binding": "RECEIPTS_BUCKET",
					"bucket_name": "breach-receipts"
				}
			],
			"ai": {
				"binding": "AI",
				"remote": true
			}
		}
	},
	"vars": {
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
	},
	"secrets": {
		"required": ["TURNSTILE_SECRET_KEY", "BETTER_AUTH_SECRET"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "breach-production",
			"database_id": "cc131580-6596-4c34-adfc-d6f97a0a2337",
			"migrations_dir": "./drizzle"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "dfdb5605bfdf42a8a929ef34611b1e6d"
		}
	],
	"r2_buckets": [
		{
			"binding": "RECEIPTS_BUCKET",
			"bucket_name": "breach-receipts"
		}
	],
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}
